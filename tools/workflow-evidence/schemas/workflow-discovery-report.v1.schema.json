{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceTreeSha",
    "subjectDigest",
    "catalogDigest",
    "semanticCatalogDigest",
    "discoveryDigest",
    "compiledManifestDigest",
    "providerSourceDigest",
    "environmentDigest",
    "coverage",
    "owners",
    "workflows",
    "diagnostics",
    "state"
  ],
  "properties": {
    "schemaVersion": {
      "const": "workflow-discovery-report/v1"
    },
    "sourceTreeSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "subjectDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalogDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semanticCatalogDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "discoveryDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compiledManifestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "providerSourceDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environmentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owners",
        "assets",
        "commands",
        "workflows"
      ],
      "properties": {
        "owners": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "assets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "commands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1280000
        },
        "workflows": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "classified",
            "excluded",
            "unclassified",
            "ambiguous"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20000
            },
            "classified": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20000
            },
            "excluded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20000
            },
            "unclassified": {
              "const": 0
            },
            "ambiguous": {
              "const": 0
            }
          }
        }
      }
    },
    "owners": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "assetCount",
          "commandCount"
        ],
        "properties": {
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*\\.[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
              }
            }
          },
          "assetCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20000
          },
          "commandCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20000
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "path",
          "role",
          "classification",
          "sha256",
          "bytes",
          "compilation"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "role": {
            "enum": [
              "template",
              "sample",
              "fixture",
              null
            ]
          },
          "classification": {
            "enum": [
              "inventory_only",
              "published_v2",
              "unselected_v2",
              "negative_fixture",
              "excluded",
              "unclassified"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "compilation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "collection",
                  "slot",
                  "generation",
                  "packageDigest",
                  "lockfileDigest",
                  "environmentDigest",
                  "planDigest"
                ],
                "properties": {
                  "collection": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "slot": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "generation": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "packageDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "lockfileDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "environmentDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "planDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 0
    },
    "state": {
      "const": "verified"
    }
  }
}
