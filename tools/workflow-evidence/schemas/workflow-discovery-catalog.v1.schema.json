{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceTreeSha",
    "owners"
  ],
  "properties": {
    "schemaVersion": {
      "const": "workflow-discovery-catalog/v1"
    },
    "sourceTreeSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "owners": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "ownerDirectory",
          "archive",
          "package",
          "manifest",
          "claims",
          "registryApi",
          "commands",
          "declarations",
          "assets"
        ],
        "properties": {
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*\\.[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
              }
            }
          },
          "ownerDirectory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256",
              "bytes"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 67108864
              }
            }
          },
          "package": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "vsix"
            ],
            "properties": {
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 67108864
                  }
                }
              },
              "vsix": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 67108864
                  }
                }
              }
            }
          },
          "manifest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "vsix"
            ],
            "properties": {
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 67108864
                  }
                }
              },
              "vsix": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 67108864
                  }
                }
              }
            }
          },
          "claims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "vsix"
            ],
            "properties": {
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 67108864
                  }
                }
              },
              "vsix": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 67108864
                  }
                }
              }
            }
          },
          "registryApi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "max": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          },
          "commands": {
            "type": "array",
            "maxItems": 20000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "declarations": {
            "type": "array",
            "maxItems": 20000,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id",
                    "path"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "workflow_templates",
                        "schemas"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id",
                    "contractVersion"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "action_providers",
                        "preflight_checks",
                        "result_sinks",
                        "agent_provider"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "contractVersion": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  }
                }
              ]
            }
          },
          "assets": {
            "type": "array",
            "maxItems": 20000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id",
                "path",
                "bytes",
                "sha256"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "workflow_templates",
                    "schemas"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 67108864
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
