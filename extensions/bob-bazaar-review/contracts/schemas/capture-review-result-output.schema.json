{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.schemas/bob-bazaar-review/capture-review-result-output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "source", "valid", "issueCount"],
  "properties": {
    "status": { "enum": ["ok", "error"] },
    "source": { "type": "string" },
    "reviewId": { "type": "string" },
    "jsonPath": { "type": "string" },
    "markdownPath": { "type": "string" },
    "metadataPath": { "type": "string" },
    "jsonText": { "type": "string" },
    "valid": { "type": "boolean" },
    "issueCount": { "type": "integer", "minimum": 0 },
    "issues": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "object" }
  }
}
