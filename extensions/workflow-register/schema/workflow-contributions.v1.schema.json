{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-contributions.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner",
    "registry_api",
    "action_providers",
    "preflight_checks",
    "result_sinks",
    "workflow_templates",
    "schemas"
  ],
  "properties": {
    "schema_version": {
      "const": "workflow-contributions/v1"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*\\.[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      }
    },
    "registry_api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^provider-registry/v[1-9][0-9]*$"
        },
        "max": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^provider-registry/v[1-9][0-9]*$"
        }
      }
    },
    "action_providers": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "preflight_checks": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "result_sinks": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/sink"
      }
    },
    "workflow_templates": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "schemas": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "agent_provider": {
      "$ref": "#/$defs/provider"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*/v[1-9][0-9]*$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contract_version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "contract_version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "sink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "contract_version"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/id"
        },
        "contract_version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
