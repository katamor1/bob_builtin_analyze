{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.schemas/workflow-contributions.v1.schema.json",
  "title": "Workflow contribution manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner",
    "registry_api",
    "action_providers",
    "preflight_checks",
    "result_sinks",
    "workflow_templates",
    "workflow_claims",
    "workflow_exclusions",
    "external_commands",
    "schemas"
  ],
  "properties": {
    "schema_version": {
      "const": "workflow-contributions/v1"
    },
    "owner": {
      "$ref": "#/$defs/owner"
    },
    "registry_api": {
      "$ref": "#/$defs/registryApi"
    },
    "action_providers": {
      "type": "array",
      "items": { "$ref": "#/$defs/actionProvider" }
    },
    "preflight_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/preflightCheck" }
    },
    "result_sinks": {
      "type": "array",
      "items": { "$ref": "#/$defs/resultSink" }
    },
    "agent_provider": {
      "$ref": "#/$defs/agentProvider"
    },
    "workflow_templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflowTemplate" }
    },
    "workflow_claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflowClaim" }
    },
    "workflow_exclusions": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflowExclusion" }
    },
    "external_commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/externalCommand" }
    },
    "schemas": {
      "type": "array",
      "items": { "$ref": "#/$defs/schemaDeclaration" }
    }
  },
  "$defs": {
    "extensionId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "registryVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^provider-registry/v[1-9][0-9]*$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "contractVersion": {
      "type": "string",
      "minLength": 4,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*/v[1-9][0-9]*$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/extensionId" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "registryApi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/registryVersion" },
        "max": { "$ref": "#/$defs/registryVersion" }
      }
    },
    "actionProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract_version", "input_schema", "output_schema", "error_codes"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "input_schema": { "$ref": "#/$defs/identifier" },
        "output_schema": { "$ref": "#/$defs/identifier" },
        "error_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "preflightCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract_version", "result_schema"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "result_schema": { "$ref": "#/$defs/identifier" }
      }
    },
    "resultSink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "contract_version", "payload_schema"],
      "properties": {
        "type": { "$ref": "#/$defs/identifier" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "payload_schema": { "$ref": "#/$defs/identifier" }
      }
    },
    "agentProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract_version", "capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "workflowTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "destinations"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/repoPath" },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        }
      }
    },
    "workflowClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "role": {
          "enum": ["product", "template", "sample", "fixture"]
        }
      }
    },
    "workflowExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "externalCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract_version", "workflow_paths"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "workflow_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        }
      }
    },
    "schemaDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/repoPath" }
      }
    }
  }
}
