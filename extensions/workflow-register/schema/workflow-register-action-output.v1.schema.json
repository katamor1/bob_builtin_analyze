{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.schemas/workflow-register-action-output.v1.schema.json",
  "title": "Workflow Register built-in action output v1",
  "description": "The canonical JSON projection of a provider result. JavaScript undefined is normalized to null before publication.",
  "$ref": "#/$defs/jsonValue",
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    }
  }
}
