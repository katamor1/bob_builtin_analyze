# Source and build configuration not needed at runtime
src/**
docs/**
*.ts
out/**/*.map
*.tsbuildinfo
tsconfig.json

# Dependency caches and package-manager files
node_modules/**
!node_modules/ajv/**
!node_modules/fast-deep-equal/**
!node_modules/fast-uri/index.js
!node_modules/fast-uri/package.json
!node_modules/fast-uri/LICENSE
!node_modules/fast-uri/lib/**
!node_modules/json-schema-traverse/**
!node_modules/require-from-string/**
!node_modules/js-yaml/index.js
!node_modules/js-yaml/package.json
!node_modules/js-yaml/LICENSE
!node_modules/js-yaml/lib/**
!node_modules/argparse/**
!node_modules/semver/**
npm-debug.log*
yarn.lock
package-lock.json
pnpm-lock.yaml

# Local editor/runtime files
.vscode/**
.vscode-test.json
*.vsix
.DS_Store
Thumbs.db

# Tests and temporary output
test/**
tests/**
coverage/**
.tmp/**
tmp/**

# Repository metadata
.git/**
.gitignore

# P7 standalone repository evidence tools are not product runtime entrypoints.
scripts/compile-workflow-contract-v2-packages.js
scripts/lib/workflow-contract-v2-environment.js

# P7 build-only AST compactor uses the existing TypeScript dev dependency.
scripts/lib/compact-manifest-module.js

# R1 build/CI tools have no installed runtime importers.
scripts/run-unused-checks.js
scripts/recompress-vsix.js
scripts/check-vsix-policy.js
scripts/check-import-cycles.js
scripts/check-export-star-policy.js
scripts/check-contract-v2-runtime-reachability.js
