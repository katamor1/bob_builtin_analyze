    "configuration": {
      "title": "Bob ワークフロー登録",
      "properties": {
        "workflowRegister.sourceId": {
          "type": "string",
          "default": "workflow-register",
          "description": "IBM Bob にワークフローを登録するときの内部識別子です。通常は変更しません。"
        },
        "workflowRegister.sourceName": {
          "type": "string",
          "default": "ワークフロー登録",
          "description": "IBM Bob に表示する登録元の名称です。"
        },
        "workflowRegister.agentCommand": {
          "type": "string",
          "default": "",
          "description": "単独実行時に AI ステップを処理する任意の VS Code コマンド ID です。AgentExecutionInput を受け取り、text・result・output・content のいずれかを含む文字列またはオブジェクトを返す必要があります。"
        },
        "workflowRegister.aiProviderCommand": {
          "type": "string",
          "default": "",
          "description": "WorkflowAiProvider として使う任意の VS Code command。{ kind, payload } を受け取り、workflow design draft、repair proposal、diagnostic explanation を返します。"
        },
        "workflowRegister.taskSnapshots.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Bob UI での実行時に、復旧用の保存済みタスク情報を .bob/workflows/runs/<runId>/task-snapshots へ保存します。"
        },
        "workflowRegister.taskSnapshots.maxBytes": {
          "type": "number",
          "default": 262144,
          "minimum": 1024,
          "maximum": 1048576,
          "description": "保存済みタスク情報1件の最大サイズです。超過時は古いメッセージから省略します。"
        },
        "workflowRegister.taskSnapshots.maxPerRun": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "description": "1回の実行に保持する保存済みタスク情報の件数です。latest.json はこの件数に含めません。"
        },
        "workflowRegister.taskSnapshots.includeMessages": {
          "type": "boolean",
          "default": false,
          "description": "保存済みタスク情報に Bob のチャットメッセージを含めます。必要な場合だけ明示的に有効化してください。無効時もメタデータと lastAssistantText は機密情報を除去して保存します。"
        },
        "workflowRegister.taskSnapshots.pruneOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存時に上限件数を超えた古い保存済みタスク情報を整理します。"
        },
        "workflowRegister.runControl.maxRunMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "次の安全な区切りで実行を自動停止するまでの最大時間（分）です。0 で無効になります。"
        },
        "workflowRegister.runControl.maxAgentStepsPerRun": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "1回の実行で開始できる AI ステップの呼び出し回数上限です。0 で無効になります。"
        },
        "workflowRegister.runControl.pauseAtLocalTime": {
          "type": "string",
          "default": "",
          "pattern": "^$|^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "description": "指定したローカル時刻以降は新しいステップを開始せず、自動停止します。空文字で無効になります。"
        },
        "workflowRegister.runControl.timezone": {
          "type": "string",
          "default": "Asia/Tokyo",
          "description": "pauseAtLocalTime の判定に使う IANA timezone。"
        },
        "workflowRegister.runs.retention.enabled": {
          "type": "boolean",
          "default": false,
          "description": "将来の実行履歴の自動整理を許可する予約設定です。現在の手動整理コマンドは、この値に関係なく利用できます。"
        },
        "workflowRegister.runs.retention.completedDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "完了から指定日数を超えた終了済みの実行を、手動整理の候補にします。"
        },
        "workflowRegister.runs.retention.maxCompletedRuns": {
          "type": "integer",
          "default": 100,
          "minimum": 0,
          "description": "保持する終了済みの実行（completed / failed）の件数目安です。超過分を手動整理の候補にします。"
        },
        "workflowRegister.runs.retention.maxTotalBytes": {
          "type": "integer",
          "default": 524288000,
          "minimum": 0,
          "description": "実行履歴の保存容量上限（バイト）の目安です。超過分を手動整理の候補にします。"
        }
      }
    },
