  "publisher": "local",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "directory": "extensions/workflow-register"
  },
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
