{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bob.local/schemas/meta/processing-budget-report-2020-12.schema.json",
  "$dynamicAnchor": "meta",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/unevaluated": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
    "https://json-schema.org/draft/2020-12/vocab/format-annotation": true,
    "https://json-schema.org/draft/2020-12/vocab/content": true,
    "https://bob.local/vocab/utf8-nfc/v1": true,
    "https://bob.local/vocab/report-constraints/v1": true
  },
  "title": "Bob processing-report JSON Schema meta-schema",
  "$comment": "Validators must implement the required UTF-8/NFC and report-constraint vocabularies or refuse this schema. The canonical implementation is validateProcessingBudgetReport().",
  "allOf": [
    { "$ref": "https://json-schema.org/draft/2020-12/schema" }
  ],
  "properties": {
    "x-bob-maxUtf8Bytes": {
      "type": "integer",
      "minimum": 0
    },
    "x-bob-unicodeNormalization": {
      "const": "NFC"
    },
    "x-bob-uniqueCompositeKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
