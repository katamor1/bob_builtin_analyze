{
  "name": "jcl",
  "fileTypes": ["jcl", "proc", "cntl"],
  "patterns": [
    {
      "name": "comment.line.jcl",
      "match": "(//|XX|\\+\\+)\\*.*$"
    },
    {
      "begin": "(?i:DD\\s+\\*$|DD\\s+\\*.*[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]$)",
      "beginCaptures": {
        "0": {
          "name": "keyword.jcl"
        }
      },
      "name": "meta.symbol.jcl",
      "end": "(?i:((//|XX|\\+\\+)[A-Za-z0-9\\$\\#@\\.]*)|/\\*)",
      "endCaptures": {
        "0": {
          "name": "variable.parameter.jcl"
        }
      }
    },
    {
      "match": "((//|XX|\\+\\+)[A-Za-z0-9\\$\\#@\\.]*)\\s+(COMMAND|CNTL|ENCNTL|EXEC|IF|THEN|ELSE|ENDIF|INCLUDE(\\s+MEMBER)?|JCLLIB(\\s+(ORDER|PROCLIB))?|JOB|OUTPUT|PEND|UTPROC|PROC|SET|XMIT)",
      "captures": {
        "1": {
          "name": "variable.parameter.jcl"
        },
        "2": {
          "name": "keyword.other.jcl"
        },
        "3": {
          "name": "keyword.other.jcl"
        }
      }
    },
    {
      "match": "(^(/|X|\\+)\\*JOBPARM)",
      "name": "keyword.other.jcl"
    },
    {
      "match": "(?<![a-zA-Z])(BURST|B|BYTES|M|CARDS|C|FORMS|F|LINECT|K|LINES|L|NOLOG|J|PAGES|G|PROCLIB|P|RESTART|E|ROOM|R|SYSAFF|S|TIME|T)(=)",
      "captures": {
        "1": {
          "name": "keyword.other.jcl"
        },
        "2": {
          "name": "keyword.operator.jcl"
        }
      }
    },
    {
      "match": "(^(/|X|\\+)\\*OUTPUT)",
      "name": "keyword.other.jcl"
    },
    {
      "match": "(?<![a-zA-Z])(BURST|CHARS|CKPTLNS|CKPTPGS|COMPACT|COPIES|COPYG|DEST|FCB|FLASHC|FLASH|FORMS|B|X|E|P|Z|N|G|D|C|Q|O|F)(=)",
      "captures": {
        "1": {
          "name": "variable.parameter.jcl"
        },
        "2": {
          "name": "keyword.operator.jcl"
        }
      }
    },
    {
      "match": "(^(/|X|\\+)\\*MESSAGE)\\s+(.*$)",
      "captures": {
        "1": {
          "name": "keyword.other.jcl"
        },
        "2": {
          "name": "token.info-token.jcl"
        }
      }
    },
    {
      "match": "(^(/|X|\\+)\\*(?i:NETACCT|NOTIFY|SETUP|SIGNOFF|SIGNON|XEQ|XMIT))\\s+(.*$)",
      "captures": {
        "1": {
          "name": "keyword.other.jcl"
        },
        "2": {
          "name": "variable.parameter.jcl"
        }
      }
    },
    {
      "match": "(^(/|X|\\+)/\\*PRIORITY)\\s+([a-zA-Z0-9])(.*$)",
      "captures": {
        "1": {
          "name": "keyword.other.jcl"
        },
        "2": {
          "name": "token.info-token.jcl"
        },
        "3": {
          "name": "token.error-token.jcl"
        }
      }
    },
    {
      "match": "(^(/|X|\\+)\\*ROUTE)\\s+(PRINT|PUNCH|XEQ)\\s+(.*$)",
      "captures": {
        "1": {
          "name": "keyword.other.jcl"
        },
        "2": {
          "name": "variable.parameter.jcl"
        },
        "3": {
          "name": "meta.symbol.jcl"
        }
      }
    },
    {
      "match": "(//\\s+|XX|\\+\\+)",
      "name": "keyword.continuation.jcl"
    },
    {
      "match": "'.*'",
      "name": "string.quoted.single.jcl"
    },
    {
      "match": "(?i:DSN|DISP|DCB|UNIT|VOL|SYSOUT|SPACE|RECFM|LRECL)(=)",
      "captures": {
        "0": {
          "name": "keyword.other.jcl"
        },
        "1": {
          "name": "keyword.operator.jcl"
        }
      }
    },
    {
      "match": "(?i:PGM|UTPROC|PROC|PARM|ADDRSPC|ACCT|TIME|REGION|COND|DSNME|DATAC)(=)",
      "name": "keyword.other.jcl",
      "captures": {
        "1": {
          "name": "variable.exec.language.jcl"
        },
        "2": {
          "name": "keyword.operator.jcl"
        }
      }
    },
    {
      "match": "(?i:ADDSPC|BYTES|CARDS|DSENQSHR|GROUP|JESLOG|JOBRC|LINES|MEMLIMIT|MSGCLASS|MSGLEVEL|NOTIFY|PAGES|PASSWORD|PERFORM|PRTY|RD|REGION|RESTART|SECLABEL|SCHENV|SYAFF|SYSTEM|TIME|TYPRUN|UJOBCORR|USER|CLASS|UID)(=|$)",
      "name": "keyword.language.job.jcl",
      "captures": {
        "1": {
          "name": "constant.language.job.jcl"
        },
        "2": {
          "name": "keyword.operator.jcl"
        }
      }
    },
    {
      "match": "(?<![a-zA-Z])(NEW|DELETE|CYL|OLD|KEEP|KEEP|SHR|PASS|CATLG|MOD|CATLG|UNCATLG)(?=$|,|=)",
      "name": "variable.language.jcl",
      "captures": {
        "1": {
          "name": "keyword.control.language.disp.jcl"
        }
      }
    },
    {
      "match": "(?i:HOLD|JCLHOLD|SCAN)",
      "name": "keyword.language.typrun.jcl",
      "captures": {
        "1": {
          "name": "constant.language.typrun.jcl"
        }
      }
    },
    {
      "match": "(?<![a-zA-Z])(?i:BFALN|BFTEK|BLKSIZE|BUFIN|BUFL|BUFMAX|BUFNO|BUFOFF|BUFOUT|BUFSIZE|CPRI|CYLOFL|DEN|DIAGNS|DSORG|EROPT|FUNC|GNCP|INTVL|IPL|TXID|KEYLEN|LIMCT|LRECL|MODE|NCP|NTM|OPTCD|PCI|PRTSP|RECFM|RESERVE|RKP|STACK|THRESH|TRTCH)(?![a-zA-Z])",
      "name": "keyword.language.dcb.jcl",
      "captures": {
        "1": {
          "name": "constant.language.dbc.jcl"
        }
      }
    },
    {
      "match": "(?<![&-_\\.a-zA-Z])(?i:BLKSIZE|DCB|DDname|DEST|DISP|DSNAME|DSNTYPE|EXPDT|KEYLEN|LABEL|LIKE|LRECL|OUTLIM|OUTPUT|RECFM|RECORG|RETPD|SPACE|SYSOUT|UNIT|VOLUME)(?![a-zA-Z0-9])",
      "name": "keyword.language.dcb.jcl",
      "captures": {
        "1": {
          "name": "constant.language.dbc_generic.jcl"
        }
      }
    },
    {
      "match": "(?i:COND\\..*=|COND=)",
      "name": "keyword.control.conditional.jcl"
    },
    {
      "match": "(?<![a-zA-Z])(?i:LT|GT|GE|EQ|LE|NE|EVEN|ONLY)(?=\\)|,)",
      "name": "keyword.operator.comparison.jcl"
    },
    {
      "match": "^((//|XX|\\+\\+)[A-Za-z0-9\\$\\#@\\.]*)",
      "name": "variable.parameter.jcl",
      "captures": {
        "2": { "name": "keyword.other.jcl" }
      }
    },
    {
      "match": "(?i:DD\\s+)",
      "name": "keyword.other.jcl"
    }
  ],
  "scopeName": "source.jcl"
}
