:{"clean":"rm -rf dist node_modules .vite .turbo","vscode:prepublish":"npm run package","package":"npm run gen-l10n && npm run typecheck && npm run lint && npm run build:web && npm run build:ext -- --production","vsix":"vsce package --no-dependencies","build":"npm run build:ext && npm run build:web","build:ext":"node esbuild.js","watch:ext":"node esbuild.js --watch","build:web":"pnpm --filter bob-web build","build:webdev":"pnpm --filter bob-web dev","test":"vitest run","typecheck":"tsc --noEmit","lint":"eslint src","lint:fix":"eslint src --fix","format":"prettier --write \"src/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\"","format:check":"prettier --check \"src/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\"","types":"tsc --project tsconfig.json --declaration --allowJs --emitDeclarationOnly --outDir ./bobapi/dist","gen-l10n":"vscode-l10n-dev export --outDir ./l10n ./src","gen-l10n-pseudo":"vscode-l10n-dev generate-pseudo -o ./l10n/ ./l10n/bundle.l10n.json ./package.nls.json"}}