{
  "name": "bob-code-consistency-review-scaffold",
  "version": "0.1.0",
  "private": true,
  "description": "Scaffold for bob code consistency pre-review MVP tooling.",
  "type": "module",
  "bin": {
    "bob-review": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preprocess": "node dist/cli/main.js preprocess",
    "validate-output": "node dist/cli/main.js validate-output",
    "triage": "node dist/cli/main.js triage"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
